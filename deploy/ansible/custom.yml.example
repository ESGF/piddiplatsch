---
# Copy this file to custom.yml and edit it. custom.yml is ignored by Git and
# included automatically by the playbook, overriding its defaults. When it is
# absent, the playbook loads the committed empty null.yml fallback.

# Kafka topic consumed by this Piddi instance.
piddi_topic: ESGF-PUBLICATIONS

# Site-specific Kafka settings. Authentication inherits SASL_SSL / PLAIN from
# packaged defaults. These keys match [kafka] in etc/esgf-example.toml.
piddi_kafka:
  # Copy the broker endpoint(s) supplied for your ESGF Kafka access.
  bootstrap.servers: broker1.example.org:9093
  # Copy your assigned consumer group; keep it stable and unique per workflow.
  group.id: de.dkrz.test.20260907-01
  # ESGF calls this required client identifier the Resource.
  client.id: YOUR_ESGF_RESOURCE
  # ESGF API key and API secret (librdkafka SASL property names).
  sasl.username: YOUR_ESGF_API_KEY
  sasl.password: YOUR_ESGF_API_SECRET
  # Override only if your broker requires another mechanism:
  # sasl.mechanisms: SCRAM-SHA-512
  # If your broker uses a custom CA, set its path on the deployed host:
  # ssl.ca.location: /path/to/ca.pem

# Optional TOML for Handle profiles, credentials, and plugin-specific settings.
# Keep custom.yml local or encrypt it with Ansible Vault before sharing it.
piddi_config_extra: |
  [handles]
  default = "production"

  [handles.profiles.production]
  server_url = "https://handle.example.org"
  prefix = "21.YOUR_PREFIX"
  username = "300:21.YOUR_PREFIX/YOUR_HANDLE_USERNAME"
  password = "YOUR_HANDLE_PASSWORD"
  verify_https = true

  # Do not add file links to dataset Handle records.
  [plugins.cmip6]
  max_parts = 0

  [plugins.cordex-cmip6]
  max_parts = 0

  [plugins.cmip6plus]
  max_parts = 0

  [plugins.cmip7]
  max_parts = 0

# Uncomment after the foreground test succeeds.
# piddi_enable_service: true

# Override only when the checkout or Conda environment uses another location.
# piddi_conda_env: /opt/piddiplatsch/.conda
