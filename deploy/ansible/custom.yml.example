---
# Copy this file to custom.yml and edit it. custom.yml is ignored by Git and
# included automatically by the playbook, overriding its defaults. When it is
# absent, the playbook loads the committed empty null.yml fallback.

# Site-specific Kafka settings. These are merged over the production defaults,
# including SASL_SSL with the PLAIN mechanism.
piddi_kafka:
  bootstrap.servers: broker1.example.org:9093
  group.id: piddi-esgf

# Optional TOML for Handle profiles, credentials, and plugin-specific settings.
# Keep custom.yml local or encrypt it with Ansible Vault before sharing it.
piddi_config_extra: |
  # [handles]
  # default = "production"

# Uncomment after the foreground test succeeds.
# piddi_enable_service: true

# Override only when the checkout or Conda environment uses another location.
# piddi_conda_env: /opt/piddiplatsch/.conda
