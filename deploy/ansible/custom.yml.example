---
# Optional deployment controls. Copy to custom.yml only when overrides are needed.
# All application settings (Kafka, Handles, projects, mapping) live in the same
# root custom.toml used by manual runs. Do not duplicate them here.

# Use another application file instead of the checkout's custom.toml:
# piddi_config_source: /path/to/site.toml

# Uncomment after the foreground test succeeds.
# piddi_enable_service: true

# Override only when the Conda environment uses another location.
# piddi_conda_env: /opt/piddiplatsch/.conda
