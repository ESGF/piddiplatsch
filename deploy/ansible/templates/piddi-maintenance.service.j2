[Unit]
Description=Maintain Piddiplatsch archives and completed output
RequiresMountsFor=/var/lib/piddi
ConditionPathExists=!/var/lib/piddi/.disk-space-stop

[Service]
Type=oneshot
User={{ piddi_user }}
Group={{ piddi_group }}
WorkingDirectory=/var/lib/piddi
ExecStart={{ piddi_executable }} --config /etc/piddi/piddi.toml --silent maintain
TimeoutStartSec=infinity
Nice=19
IOSchedulingClass=idle
UMask=0027
Environment=PYTHONUNBUFFERED=1
