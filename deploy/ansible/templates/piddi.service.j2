[Unit]
Description=Piddiplatsch Kafka catalog harvest
Documentation=https://github.com/ESGF/piddiplatsch
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/piddi

[Service]
Type=simple
User={{ piddi_user }}
Group={{ piddi_group }}
WorkingDirectory=/var/lib/piddi
ExecStart={{ piddi_executable }} --config /etc/piddi/piddi.toml --silent harvest --idle-timeout 0
Restart=on-failure
RestartSec=10s
KillSignal=SIGINT
TimeoutStopSec=60s
UMask=0027
StateDirectory=piddi
StateDirectoryMode=0750
LogsDirectory=piddi
LogsDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
